# DistributorOS API environment template.
# Server-only values belong in Render/Supabase/GitHub secrets, not in frontend builds.

ENVIRONMENT=development

# Runtime API role. In staging/production this should be a non-owner, non-BYPASSRLS role.
DATABASE_URL=postgresql+asyncpg://distributoros_runtime:replace-me@localhost:5432/distributoros

# Migration/maintenance role. Use this for Alembic; do not use it as the API runtime role.
DATABASE_MIGRATION_URL=postgresql+asyncpg://distributoros_migrator:replace-me@localhost:5432/distributoros
DATABASE_ADMIN_URL=postgresql+asyncpg://distributoros_migrator:replace-me@localhost:5432/distributoros

# Conservative defaults for one small hosted API instance.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=1800

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=distributoros-api
JWT_AUDIENCE=distributoros-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PASSWORD_RESET_URL_BASE=http://localhost:8081/reset-password

INVOICE_PDF_ROOT=storage/invoices
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
REFRESH_RATE_LIMIT=30
SEARCH_RATE_LIMIT=60
REFRESH_GRACE_SECONDS=5

# Password reset delivery. Required before production launch if reset emails are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
