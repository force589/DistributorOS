{
  "expo": {
    "name": "DistributorOS",
    "slug": "distributoros",
    "scheme": "distributoros",
    "version": "0.8.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "splash": {
      "backgroundColor": "#155EEF",
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.distributoros.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#155EEF",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.distributoros.app",
      "buildNumber": "8",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}
