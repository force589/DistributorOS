# Expo public build-time values. Never put database URLs, JWT secrets, SMTP secrets,
# Supabase service-role keys, or other server-only credentials in this file.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://distributoros-api-sg.onrender.com/api/v1
EXPO_PUBLIC_WEB_API_URL=https://distributoros-api-sg.onrender.com/api/v1
EXPO_PUBLIC_ANDROID_API_URL=https://distributoros-api-sg.onrender.com/api/v1
EXPO_PUBLIC_IOS_API_URL=https://distributoros-api-sg.onrender.com/api/v1

# For intentional local backend development only, override the API URLs in
# an untracked apps/mobile/.env file. Production, preview, Android, and iOS values
# must be absolute HTTPS URLs. On Cloudflare Pages production, the web bundle
# calls /api/v1 on the same origin; EXPO_PUBLIC_API_URL configures the Pages
# Function upstream.
