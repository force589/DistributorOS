# DistributorOS local development template.
# Copy to .env and replace every placeholder. Never commit real .env files.

# Local PostgreSQL container settings.
POSTGRES_DB=distributoros
POSTGRES_USER=distributoros_admin
POSTGRES_PASSWORD=replace-with-a-local-admin-password

# Server-only backend settings.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://distributoros_admin:replace-with-a-local-admin-password@localhost:5432/distributoros
DATABASE_MIGRATION_URL=postgresql+asyncpg://distributoros_admin:replace-with-a-local-admin-password@localhost:5432/distributoros
DATABASE_ADMIN_URL=postgresql+asyncpg://distributoros_admin:replace-with-a-local-admin-password@localhost:5432/distributoros
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=distributoros-api
JWT_AUDIENCE=distributoros-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PASSWORD_RESET_URL_BASE=http://localhost:8081/reset-password
RATE_LIMIT_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Public Expo settings. These are bundled into web/native clients.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://distributoros-api.onrender.com/api/v1
EXPO_PUBLIC_WEB_API_URL=https://distributoros-api.onrender.com/api/v1
EXPO_PUBLIC_ANDROID_API_URL=https://distributoros-api.onrender.com/api/v1
EXPO_PUBLIC_IOS_API_URL=https://distributoros-api.onrender.com/api/v1
